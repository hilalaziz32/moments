# Single source of truth for environment variables. Any new process.env.X MUST be
# added here (house rule carried over from scaletopiaCentre).

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres, session-mode pooler. Used by migrations and the worker only.
DATABASE_URL=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Your own sign-in email(s), comma-separated. Only these can open /admin.
SUPER_ADMIN_EMAILS=
PROCESS_ROLE=all
INTERNAL_API_KEY=

# --- Slack ----------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_ACTION_SECRET=

# --- WhatsApp (Meta Cloud API via 360dialog BSP) --------------------------
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- SMS (Twilio) ---------------------------------------------------------
# One Twilio account for the whole platform. Needed on BOTH the worker (sends)
# and web (admin number picker, test texts, delivery receipts). Each customer's
# sending number is picked in /admin; the From number / Messaging Service below
# is the default for customers without one.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public https URL of the web app's receipt endpoint, e.g.
# https://moments-web-lemon.vercel.app/api/twilio/status
TWILIO_STATUS_CALLBACK_URL=

# --- Email (Resend) — on hold until there are customers ------------------
RESEND_API_KEY=
EMAIL_FROM=Moments <notify@moments.pk>
