{
  "name": "@moments/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schedule": { "types": "./dist/schedule/index.d.ts", "default": "./dist/schedule/index.js" },
    "./csv": { "types": "./dist/csv/index.d.ts", "default": "./dist/csv/index.js" },
    "./money": { "types": "./dist/money/index.d.ts", "default": "./dist/money/index.js" },
    "./messages": { "types": "./dist/messages/index.d.ts", "default": "./dist/messages/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
